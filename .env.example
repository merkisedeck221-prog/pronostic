# Variables d'environnement — cahier des charges, section 9.
# Copier ce fichier en .env.local (jamais commité) et remplir les valeurs.
# Sur Vercel : Settings > Environment Variables (Production et Preview).

# --- Supabase ---
# URL du projet Supabase (client et serveur), ex. https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Clé publique « anon » ou « publishable » (client et serveur)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé secrète service_role : SERVEUR UNIQUEMENT (tâches planifiées et webhooks)
SUPABASE_SERVICE_ROLE_KEY=

# --- Application ---
# URL publique de l'application (client et serveur), ex. http://localhost:3000 — facultative (repli)
NEXT_PUBLIC_APP_URL=
# Fuseau d'affichage par défaut (client et serveur) ; défaut : Africa/Porto-Novo
DEFAULT_TIMEZONE=Africa/Porto-Novo

# --- API-Football ---
# Clé API-Football (api-sports.io) : serveur uniquement
API_FOOTBALL_KEY=
# Plafond quotidien d'appels : 90 en forfait gratuit, ex. 5000 en Pro ; défaut : 90
API_FOOTBALL_DAILY_BUDGET=

# --- OpenAI ---
# Clé OpenAI : serveur uniquement
OPENAI_API_KEY=
# Modèle utilisé pour les pronostics (récent, économique, sorties structurées) : serveur uniquement
OPENAI_MODEL=
# Nombre maximum de matchs analysés par jour ; défaut : 20
AI_DAILY_GENERATION_LIMIT=

# --- Sécurité et pilotage ---
# Secret partagé protégeant /api/cron/* (serveur et Supabase Cron), 32 caractères minimum
# Générer avec : openssl rand -hex 32
CRON_SECRET=
# E-mails promus administrateurs, séparés par des virgules : serveur uniquement
ADMIN_EMAILS=
# Fournisseur de paiement : « mock » dans le MVP ; serveur uniquement
PAYMENT_PROVIDER=mock
